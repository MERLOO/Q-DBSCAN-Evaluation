of-fold d'**une** répétition (chaque image y est prédite une fois).\n\nUne différence est crédible si l'IC95 % exclut 0 **et** si les deux p-values sont faibles.","metadata":{}},{"id":"45521dd8","cell_type":"code","source":"def nadeau_bengio(diffs, n_splits):\n    k, m, v = len(diffs), diffs.mean(), diffs.var(ddof=1)\n    if k < 2 or v == 0:\n        return m, np.nan\n    t = m / np.sqrt((1.0 / k + 1.0 / (n_splits - 1)) * v)\n    return m, 2 * stats.t.sf(abs(t), k - 1)\n\ndef mcnemar_exact(y, pa, pb):\n    ca, cb = pa == y, pb == y\n    b, c = int(np.sum(ca & ~cb)), int(np.sum(~ca & cb))\n    n = b + c\n    return b, c, (1.0 if n == 0 else stats.binomtest(b, n, 0.5).pvalue)\n\ndef bootstrap_diff_ci(y, pa, pb, n_boot=2000, seed=SEED):\n    rng = np.random.default_rng(seed)\n    d = (pa == y).astype(float) - (pb == y).astype(float)\n    boots = rng.choice(d, size=(n_boot, len(d)), replace=True).mean(axis=1)\n    return np.percentile(boots, [2.5, 97.5])\n\nfam_pairs = [(\"Q-DBSCAN\", \"DBSCAN classique\"), (\"kNN quantique\", \"kNN classique\"), (\"QSVM\", \"SVM-RBF classique\")]\nrows = []\nfor exp in res.experiment.unique():\n    for t in TASKS:\n        sub = res[(res.experiment == exp) & (res.task == t)]\n        for q_prefix, ref in fam_pairs:\n            ref_df = sub[sub.model == ref].set_index([\"repeat\", \"fold\"]).sort_index()\n            for qm in [m for m in sub.model.unique() if m.startswith(q_prefix)]:\n                q_df = sub[sub.model == qm].set_index([\"repeat\", \"fold\"]).sort_index()\n                dF1, pF1 = nadeau_bengio((q_df.f1_macro - ref_df.f1_macro).values, N_SPLITS)\n                dAc, pAc = nadeau_bengio((q_df.accuracy - ref_df.accuracy).values, N_SPLITS)\n                y_true = Y[t]\n                pa, pb = OOF[(exp, t, qm, 0)], OOF[(exp, t, ref, 0)]\n                lo, hi = bootstrap_diff_ci(y_true, pa, pb)\n                b, c, pm_ = mcnemar_exact(y_true, pa, pb)\n                rows.append({\"experiment\": exp, \"task\": 